{
  "perf_counter": {
    "implementation": "QueryPerformanceCounter()",
    "monotonic": true,
    "adjustable": false,
    "resolution": 1e-07
  },
  "monotonic": {
    "implementation": "GetTickCount64()",
    "monotonic": true,
    "adjustable": false,
    "resolution": 0.015625
  },
  "process_time": {
    "implementation": "GetProcessTimes()",
    "monotonic": true,
    "adjustable": false,
    "resolution": 1e-07
  }
}